table fact_sales
	lineageTag: 0ca40c9d-f9d1-4a20-bce7-1cf4c078c596

	/// Sum of fact_sales[units_sold] across the current filter context. Assumes units_sold is an additive quantity at the fact_sales row grain.
	measure 'Total Units Sold' = SUM(fact_sales[units_sold])
		formatString: #,##0
		lineageTag: 25e6a928-7d60-452e-a7cd-c66bc3466002

	/// Sum of fact_sales[estimated_sales_value] across the current filter context. Represents the source-provided estimated sales value; currency and accounting treatment are unconfirmed, so no currency symbol is implied.
	measure 'Estimated Sales Value' = SUM(fact_sales[estimated_sales_value])
		formatString: #,##0.00
		lineageTag: 4ea911f4-f2ea-46f3-9c5d-22729ca271db

	/// Estimated Sales Value divided by Total Units Sold in the current filter context. Returns blank when Total Units Sold is zero or blank. No currency unit is implied because the source currency is unconfirmed.
	measure 'Average Selling Price' = DIVIDE([Estimated Sales Value], [Total Units Sold])
		formatString: #,##0.00
		lineageTag: 0b180468-8440-41a2-a733-abf7d55c0159

